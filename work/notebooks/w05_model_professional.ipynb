{ "cells": [ { "cell_type": "markdown", "metadata": {}, "source": [ "# w05_model_professional — Modeling notebook (start)\n", "\n", "This notebook is the professional rewrite focused on modeling. Start here and run sequentially.\n", "\n", "Section 0: Data Contract (read and confirm before running any queries)\n", "\n", "**Tables used:**\n", "- fact_content_daily_performance (feature window: 2026-01-01 → 2026-03-31)\n", "- dim_content (static signals)\n", "- dim_clients (panel metadata)\n", "\n", "**Grain:** one row per (client_hash_id, content_hash_id) at decision point 2026-03-31\n", "\n", "**Feature window:** 2026-01-01 → 2026-03-31 (90 days)\n", "**Target window:** 2026-04-01 → 2026-04-30 (30 days)\n", "\n", "**Excluded / Leakage audit:**\n", "- trend_direction, trend_pct (label trap)\n", "- health_score, priority_score, action_type (product flags)\n", "- Any metric computed from the target window (T+1)\n", "- client_hash_id is used only for grouping, never as a feature\n", "\n", "**Run policy:** run heavy full-warehouse scans only ONCE and cache results to `work/outputs/`. The HF_TOKEN must be provided via environment variable `HF_TOKEN` or Colab userdata.\n" ] }, { "cell_type": "code", "metadata": {}, "execution_count": null, "outputs": [], "source": [ "# 0. Setup: imports, seeds, versions, and HF token handling\", "import os\", "import sys\", "import platform\", "import json\", "import time\", "import numpy as np\", "import pandas as pd\", "import duckdb\", "\", "from textwrap import shorten\", "\", "RANDOM_STATE = 42\", "np.random.seed(RANDOM_STATE)\", "\", "# HF token: prefer environment var, fallback to google.colab.userdata if available\", "HF_TOKEN = os.environ.get('HF_TOKEN')\", "if HF_TOKEN is None:\", "    try:\", "        from google.colab import userdata\", "        HF_TOKEN = userdata.get('HF_TOKEN')\", "    except Exception:\", "        HF_TOKEN = None\", "\", "print('HF_TOKEN present?', HF_TOKEN is not None)\", "\", "print('Python:', sys.version.splitlines()[0])\", "print('Platform:', platform.platform())\", "print('pandas:', pd.__version__)\", "print('numpy:', np.__version__)\", "print('duckdb:', duckdb.__version__)\", "print('sklearn available?', 'sklearn' in sys.modules or hasattr(__import__('importlib'), 'import_module'))\" ] }, { "cell_type": "code", "metadata": {}, "execution_count": null, "outputs": [], "source": [ "# 1. Lightweight warehouse verification queries (safe to run)\", "# This cell checks counts and min/max dates without materializing full 79M rows in-memory.\", "\", "con = duckdb.connect()\", "\", "# If HF_TOKEN is provided, create secret for duckdb-hf access (Colab friendly).\", "if HF_TOKEN is not None:\", "    try:\", "        con.execute(f\"CREATE SECRET (TYPE huggingface, TOKEN '{HF_TOKEN}')\")\", "    except Exception as e:\", "        print('Warning creating HF secret:', e)\", "\", "rel = 'hf://datasets/FlyRank/internship-warehouse'\", "\", "# Basic checks: dim tables and a small probe into fact table partitions.\", "try:\", "    q = \"SELECT count(*) as cnt FROM read_parquet(f'{rel}/dim_clients/*.parquet')\"\", "    r = con.execute(q).fetchdf()\", "    print('dim_clients count =', int(r['cnt'].iloc[0]))\", "except Exception as e:\", "    print('dim_clients check failed:', e)\", "\", "try:\", "    q = \"SELECT count(*) as cnt FROM read_parquet(f'{rel}/dim_content/*.parquet')\"\", "    r = con.execute(q).fetchdf()\", "    print('dim_content count =', int(r['cnt'].iloc[0]))\", "except Exception as e:\", "    print('dim_content check failed:', e)\", "\", "# Probe the daily performance table for MIN/MAX(report_date) and a row sample.\", "try:\", "    q = \"SELECT MIN(report_date) as min_date, MAX(report_date) as max_date, COUNT(*) as cnt FROM read_parquet(f'{rel}/fact_content_daily_performance/**/*.parquet')\"\", "    r = con.execute(q).fetchdf()\", "    print('fact_content_daily_performance min/max/count =', r[['min_date','max_date','cnt']].iloc[0].to_dict())\", "\", "    q2 = \"SELECT client_hash_id, content_hash_id, gsc_impressions, gsc_clicks, gsc_avg_position FROM read_parquet(f'{rel}/fact_content_daily_performance/month=2026-03/**/*.parquet') LIMIT 5\"\", "    print('Sample rows (March 2026):')\", "    print(con.execute(q2).fetchdf())\", "except Exception as e:\", "    print('Fact table probe failed (likely HF access or network):', e)\", "\", "print('\nIf any of these queries fail, confirm HF_TOKEN is available and you have network access to Hugging Face.')\" ] } ], "metadata": { "kernelspec": { "display_name": "Python 3", "name": "python3" }, "language_info": { "name": "python" } }, "nbformat": 4, "nbformat_minor": 5 }
